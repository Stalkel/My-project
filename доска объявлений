from django.shortcuts import get_object_or_404, render, redirect
from django.contrib.auth.decorators import login_required
from .models import Advertisement, Response
from .forms import AdvertisementForm, ResponseForm

def home(request):
    """Главная страница - список всех объявлений"""
    ads = Advertisement.objects.all().order_by('-created_at')
    return render(request, 'classified_ads/home.html', {'ads': ads})

@login_required
def create_advertisement(request):
    """Создание объявления"""
    if request.method == 'POST':
        form = AdvertisementForm(request.POST, request.FILES)
        if form.is_valid():
            ad = form.save(commit=False)
            ad.author = request.user
            ad.save()
            return redirect('ad_detail', pk=ad.pk)
    else:
        form = AdvertisementForm()
    return render(request, 'classified_ads/ad_form.html', {'form': form})

@login_required
def edit_advertisement(request, pk):
    """Редактирование объявления"""
    ad = get_object_or_404(Advertisement, pk=pk, author=request.user)
    if request.method == 'POST':
        form = AdvertisementForm(request.POST, request.FILES, instance=ad)
        if form.is_valid():
            form.save()
            return redirect('ad_detail', pk=ad.pk)
    else:
        form = AdvertisementForm(instance=ad)
    return render(request, 'classified_ads/ad_form.html', {'form': form})

def ad_detail(request, pk):
    """Детальный просмотр объявления"""
    ad = get_object_or_404(Advertisement, pk=pk)
    responses = ad.responses.all()
    return render(request, 'classified_ads/ad_detail.html', {
        'ad': ad,
        'responses': responses
    })

@login_required
def create_response(request, ad_pk):
    """Создание отклика на объявление"""
    ad = get_object_or_404(Advertisement, pk=ad_pk)
    
    if request.method == 'POST':
        form = ResponseForm(request.POST)
        if form.is_valid():
            response = form.save(commit=False)
            response.advertisement = ad
            response.author = request.user
            response.save()
            # Email отправится автоматически через signal
            return redirect('my_responses')
    else:
        form = ResponseForm()
    
    return render(request, 'classified_ads/response_form.html', {
        'form': form,
        'ad': ad
    })

@login_required
def my_responses(request):
    """Личная страница с откликами на объявления пользователя"""
    # Получаем все объявления пользователя
    user_ads = Advertisement.objects.filter(author=request.user)
    
    # Получаем все отклики на эти объявления
    all_responses = Response.objects.filter(
        advertisement__in=user_ads
    ).select_related('advertisement', 'author')
    
    # Фильтрация по объявлению (если передан параметр)
    ad_id = request.GET.get('ad_id')
    if ad_id:
        all_responses = all_responses.filter(advertisement_id=ad_id)
    
    return render(request, 'classified_ads/my_responses.html', {
        'responses': all_responses,
        'user_ads': user_ads
    })

@login_required
def accept_response(request, response_pk):
    """Принятие отклика"""
    response = get_object_or_404(
        Response, 
        pk=response_pk,
        advertisement__author=request.user
    )
    
    if not response.is_accepted:
        response.is_accepted = True
        response.save()
        # Email отправится автоматически через signal
    
    return redirect('my_responses')

@login_required
def delete_response(request, response_pk):
    """Удаление отклика"""
    response = get_object_or_404(
        Response,
        pk=response_pk,
        advertisement__author=request.user
    )
    response.delete()
    return redirect('my_responses')
