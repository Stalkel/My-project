class Advertisement(models.Model):
    """Модель объявления"""
    title = models.CharField(max_length=200, verbose_name="Заголовок")
    text = models.TextField(verbose_name="Текст объявления")
    category = models.CharField(
        max_length=20, 
        choices=CATEGORY_CHOICES,
        verbose_name="Категория"
    )
    author = models.ForeignKey(
        User, 
        on_delete=models.CASCADE,
        related_name='advertisements'
    )
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    # Для картинок и видео (можно использовать FileField/ImageField)
    content_media = models.TextField(
        blank=True, 
        verbose_name="Встроенный контент (HTML)"
    )
    
    def __str__(self):
        return self.title
    
    class Meta:
        verbose_name = "Объявление"
        verbose_name_plural = "Объявления"


class Response(models.Model):
    """Модель отклика на объявление"""
    advertisement = models.ForeignKey(
        Advertisement,
        on_delete=models.CASCADE,
        related_name='responses'
    )
    author = models.ForeignKey(
        User,
        on_delete=models.CASCADE,
        related_name='responses'
    )
    text = models.TextField(verbose_name="Текст отклика")
    created_at = models.DateTimeField(auto_now_add=True)
    is_accepted = models.BooleanField(
        default=False, 
        verbose_name="Принят ли отклик"
    )
    
    def __str__(self):
        return f"Отклик от {self.author.username} на {self.advertisement.title}"
    
    class Meta:
        verbose_name = "Отклик"
        verbose_name_plural = "Отклики"
        ordering = ['-created_at']


class RegistrationCode(models.Model):
    """Модель для хранения кодов подтверждения регистрации"""
    email = models.EmailField(unique=True)
    code = models.CharField(max_length=6)
    created_at = models.DateTimeField(auto_now_add=True)
    is_used = models.BooleanField(default=False)
    
    def __str__(self):
        return f"{self.email} - {self.code}"
# forms.py
from django import forms
from django.contrib.auth.models import User
from .models import Advertisement, Response

class RegistrationForm(forms.Form):
    email = forms.EmailField()
    password = forms.CharField(widget=forms.PasswordInput)
    password_confirm = forms.CharField(widget=forms.PasswordInput)
    
    def clean(self):
        cleaned_data = super().clean()
        if cleaned_data.get('password') != cleaned_data.get('password_confirm'):
            raise forms.ValidationError("Пароли не совпадают")
        return cleaned_data

class CodeVerificationForm(forms.Form):
    code = forms.CharField(max_length=6)

# views.py
import random
from django.shortcuts import render, redirect
from django.contrib.auth import login
from django.core.mail import send_mail
from django.conf import settings
from django.contrib.auth.models import User
from .forms import RegistrationForm, CodeVerificationForm
from .models import RegistrationCode

def register_request(request):
    """Запрос на регистрацию"""
    if request.method == 'POST':
        form = RegistrationForm(request.POST)
        if form.is_valid():
            email = form.cleaned_data['email']
            password = form.cleaned_data['password']
            
            # Генерация кода (6 цифр)
            code = ''.join([str(random.randint(0, 9)) for _ in range(6)])
            
            # Сохранение кода в БД
            RegistrationCode.objects.update_or_create(
                email=email,
                defaults={'code': code, 'is_used': False}
            )
            
            # Отправка email с кодом
            send_mail(
                subject='Код подтверждения регистрации',
                message=f'Ваш код подтверждения: {code}',
                from_email=settings.DEFAULT_FROM_EMAIL,
                recipient_list=[email],
                fail_silently=False,
            )
            
            # Сохранение email в сессии для следующего шага
            request.session['registration_email'] = email
            request.session['registration_password'] = password
            
            return redirect('verify_code')
    else:
        form = RegistrationForm()
    
    return render(request, 'registration/register.html', {'form': form})

def verify_code(request):
    """Проверка кода подтверждения"""
    if request.method == 'POST':
        form = CodeVerificationForm(request.POST)
        if form.is_valid():
            code = form.cleaned_data['code']
            email = request.session.get('registration_email')
            password = request.session.get('registration_password')
            
            # Проверка кода
            reg_code = RegistrationCode.objects.filter(
                email=email,
                code=code,
                is_used=False
            ).first()
            
            if reg_code:
                # Создание пользователя
                username = email.split('@')[0]  # Простой username из email
                user = User.objects.create_user(
                    username=username,
                    email=email,
                    password=password
                )
                
                # Помечаем код как использованный
                reg_code.is_used = True
                reg_code.save()
                
                # Автоматический вход
                login(request, user)
                
                # Очистка сессии
                del request.session['registration_email']
                del request.session['registration_password']
                
                return redirect('home')
            else:
                form.add_error('code', 'Неверный код или срок действия истек')
    else:
        form = CodeVerificationForm()
    
    return render(request, 'registration/verify_code.html', {'form': form})
# signals.py
from django.db.models.signals import post_save, pre_save
from django.dispatch import receiver
from django.core.mail import send_mail
from django.conf import settings
from .models import Response, Advertisement

@receiver(post_save, sender=Response)
def notify_ad_author_on_response(sender, instance, created, **kwargs):
    """
    Отправка email автору объявления при получении отклика
    """
    if created:  # Только при создании нового отклика
        author = instance.advertisement.author
        response_author = instance.author
        
        send_mail(
            subject=f'Новый отклик на ваше объявление "{instance.advertisement.title}"',
            message=f'Пользователь {response_author.username} оставил отклик на ваше объявление.\n\n'
                    f'Текст отклика:\n{instance.text}',
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[author.email],
            fail_silently=False,
        )

@receiver(pre_save, sender=Response)
def notify_user_on_response_acceptance(sender, instance, **kwargs):
    """
    Отправка email пользователю при принятии его отклика
    """
    if instance.pk:  # Если отклик уже существует (обновление)
        try:
            old_instance = Response.objects.get(pk=instance.pk)
            # Если отклик только что приняли
            if instance.is_accepted and not old_instance.is_accepted:
                user = instance.author
                ad_author = instance.advertisement.author
                
                send_mail(
                    subject=f'Ваш отклик на объявление "{instance.advertisement.title}" принят!',
                    message=f'Поздравляем! Пользователь {ad_author.username} принял ваш отклик.',
                    from_email=settings.DEFAULT_FROM_EMAIL,
                    recipient_list=[user.email],
                    fail_silently=False,
                )
        except Response.DoesNotExist:
            pass

