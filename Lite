def print_board(board):
    
    print("\n   0   1   2") 
    for i, row in enumerate(board):
        print(f"{i}  {row[0]} | {row[1]} | {row[2]}")
        if i < 2:
            print("  -----------")  
    print()


def check_winner(board):

    lines = []

    lines.extend(board)

    for col in range(3):
        lines.append([board[row][col] for row in range(3)])

    lines.append([board[i][i] for i in range(3)])  
    lines.append([board[i][2 - i] for i in range(3)])

    for line in lines:
        if line[0] == line[1] == line[2] and line[0] != " ":
            return line[0]  # Вернём 'X' или 'O'

  
    if all(cell != " " for row in board for cell in row):
        return "draw"

    return None  


def is_valid_move(board, row, col):
   
    if row < 0 or row > 2 or col < 0 or col > 2:
        print("❌ Ошибка: координаты вне поля. Введите числа от 0 до 2.")
        return False
    if board[row][col] != " ":
        print("❌ Ошибка: клетка уже занята. Выберите другую.")
        return False
    return True


def tic_tac_toe():
   
    print("🎮 Добро пожаловать в Крестики-Нолики! 🎮")
    print("Игрок 1 играет за 'X', Игрок 2 — за 'O'.")
    print("Чтобы сделать ход, введите номер строки и столбца (через пробел): например, '1 2'")

  
    board = [[" " for _ in range(3)] for _ in range(3)]
    current_player = "X"  

    while True:
        print_board(board)

        try:
            move = input(f"🕹️  Игрок {current_player}, ваш ход (строка столбец): ").strip().split()
            if len(move) != 2:
                print("❗ Введите два числа: строку и столбец (например, 0 1)")
                continue

            row, col = int(move[0]), int(move[1])

            if not is_valid_move(board, row, col):
                continue

           
            board[row][col] = current_player

            winner = check_winner(board)
            if winner == "X":
                print_board(board)
                print("🎉 Поздравляем! Игрок X выиграл! 🏆")
                break
            elif winner == "O":
                print_board(board)
                print("🎉 Поздравляем! Игрок O выиграл! 🏆")
                break
            elif winner == "draw":
                print_board(board)
                print("🤝 Ничья! Сыграйте ещё раз! ♻️")
                break

            current_player = "O" if current_player == "X" else "X"

        except ValueError:
            print("❗ Ошибка: введите только целые числа (0, 1 или 2).")
        except Exception as e:
            print(f"❗ Что-то пошло не так: {e}")

    print("Спасибо за игру! До встречи! 💖")


if __name__ == "__main__":
    tic_tac_toe()
